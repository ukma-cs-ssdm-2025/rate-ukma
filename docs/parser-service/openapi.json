	"openapi": "3.1.0",
	"info": {
		"title": "UKMA Data",
		"version": "1",
		"description": "Every list returns its rows in change-number order, removed rows included. A reader saves one change number per list, asks for `?after=<number>`, stores every page and saves the last page's `cursor` once `hasMore` is false.",
		"license": {
			"name": "GPL-3.0-or-later",
			"url": "https://www.gnu.org/licenses/gpl-3.0.html"
		}
	},
