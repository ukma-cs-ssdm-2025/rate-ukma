		"effect": "^4.0.2"
	},
	"devDependencies": {
		"@effect/vitest": "^4.0.2",
		"@oxlint/plugins": "1.87.0",
		"@types/node": "^22.20.5",
		"oxfmt": "0.62.0",
		"oxlint": "1.87.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
