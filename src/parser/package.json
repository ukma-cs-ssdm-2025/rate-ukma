{
	"name": "ukma-data",
	"private": true,
	"license": "GPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11.20.0"
	},
	"scripts": {
		"api": "node src/main.ts api",
		"worker": "node src/main.ts worker",
		"migrate": "node src/main.ts migrate",
		"reparse": "node src/main.ts reparse",
		"create-key": "node src/main.ts create-key",
		"build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
		"test": "vitest run",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
		"check:all": "pnpm run check && pnpm run test"
	},
	"dependencies": {
		"@effect/platform-node": "^4.0.2",
		"@effect/sql-pg": "^4.0.2",
		"effect": "^4.0.2"
	},
	"devDependencies": {
		"@effect/vitest": "^4.0.2",
		"@oxlint/plugins": "1.87.0",
		"@types/node": "^24.19.2",
		"esbuild": "0.28.2",
		"oxfmt": "0.62.0",
		"oxlint": "1.87.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
