	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=22.18.0",
		"pnpm": ">=11.20.0"
	},
	"scripts": {
		"api": "node src/main.ts api",
		"worker": "node src/main.ts worker",
		"migrate": "node src/main.ts migrate",
		"test": "vitest run",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
