	"scripts": {
		"dev": "vite --port 3000",
		"start": "vite --port 3000",
		"build": "pnpm run generate-api && tsc && vite build",
		"serve": "vite preview",
		"test": "vitest run",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "pnpm run lint && pnpm run format:check",
		"generate-api": "orval",
		"postinstall": "pnpm run generate-api",
		"security:audit": "pnpm audit --audit-level high",
		"security:update": "pnpm up --interactive",
		"test:e2e": "dotenv -e ../.env -- playwright test",
		"test:e2e:ui": "dotenv -e ../.env -- cross-env HEADLESS=false playwright test"
	},
