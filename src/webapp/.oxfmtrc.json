{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": [
		"src/routeTree.gen.ts",
		"src/lib/api/generated/**/*",
		"playwright-report/**/*",
		"playwright/.auth/**/*",
		"test-results/**/*",
		"tools/oxlint/anti-slop/**"
	],
	"sortPackageJson": false,
	"sortImports": false
}
